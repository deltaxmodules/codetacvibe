{
  "name": "prisma6",
  "root": "fixtures/prisma6",
  "readyPath": "/health",
  "args": [
    "server.cjs"
  ],
  "expect": [
    "dbWrite"
  ],
  "extraSecrets": [
    "Cliente-Secreto-4471"
  ],
  "requests": [
    {
      "name": "criar",
      "method": "POST",
      "path": "/api/invoices",
      "json": {
        "customer": "Cliente-Secreto-4471",
        "total": 120.5
      },
      "accept": true
    },
    {
      "name": "criar-acme",
      "method": "POST",
      "path": "/api/invoices",
      "json": {
        "customer": "acme",
        "total": 80
      },
      "accept": true
    },
    {
      "name": "listar",
      "path": "/api/invoices?customer=acme",
      "accept": true,
      "expect": [
        "dbRead"
      ]
    },
    {
      "name": "pagar",
      "method": "POST",
      "path": "/api/invoices/pay/acme",
      "accept": true
    },
    {
      "name": "apagar",
      "method": "DELETE",
      "path": "/api/invoices/latest/acme",
      "accept": true
    }
  ]
}
