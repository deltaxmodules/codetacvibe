{
  "name": "py-misto-proxy",
  "root": "{codetac}/fixtures/python/mixed/web",
  "args": ["{codetac}/node_modules/vite/bin/vite.js", "--port", "{port}", "--strictPort", "--host", "127.0.0.1"],
  "origin": "http://127.0.0.1:{port}",
  "readyPath": "/",
  "env": { "API_PORT": "{api}" },
  "companions": [
    { "name": "api", "root": "{codetac}/fixtures/python/mixed/api", "python": "{codetac}/fixtures/python/mixed/api/.venv/bin/python",
      "args": ["-m", "uvicorn", "main:app", "--port", "{api}"], "env": { "APP_DATABASE": "{out}/tasks.sqlite" }, "readyPath": "/api/tasks" }
  ],
  "prepare": [["-e", "require('fs').rmSync(process.argv[1], { force: true })", "{out}/tasks.sqlite"]],
  "extraSecrets": ["Tarefa secreta de ensaio"],
  "steps": [
    { "name": "abrir", "goto": "/", "waitFor": "document.querySelector('#adicionar')", "settle": 800, "snapshot": "inicio" },
    { "type": ["#titulo", "Tarefa secreta de ensaio"] },
    { "name": "Adicionar tarefa (proxy do Vite)", "click": "#adicionar", "after": "document.querySelectorAll('li').length === 1", "settle": 800,
      "expect": { "server": true, "component": true, "handler": "submitTask", "requestsMin": 2, "dbWrite": true,
        "functions": ["request validation (not observable)", "create_task", "add_task", "clean", "connect", "list_tasks"] }, "snapshot": "adicionada" },
    { "name": "Atualizar (proxy do Vite)", "click": "#atualizar", "settle": 1000,
      "expect": { "server": true, "component": true, "handler": "refresh", "functions": ["list_tasks", "connect"] }, "openBar": true }
  ]
}
