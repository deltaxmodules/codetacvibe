{
  "name": "py-fastapi-docs",
  "root": "{codetac}/fixtures/python/fastapi-async",
  "python": "{root}/.venv/bin/python",
  "args": ["-m", "fastapi", "dev", "main.py", "--port", "{port}"],
  "origin": "http://127.0.0.1:{port}",
  "readyPath": "/docs",
  "env": { "APP_DATABASE_URL": "sqlite+aiosqlite:///{out}/notes.sqlite" },
  "prepare": [["-e", "require('fs').rmSync(process.argv[1], { force: true })", "{out}/notes.sqlite"]],
  "extraSecrets": ["Nota de ensaio no navegador", "Nota renomeada no navegador"],
  "steps": [
    { "name": "abrir /docs", "goto": "/docs", "waitFor": "document.querySelectorAll('.opblock').length >= 4", "settle": 800, "snapshot": "docs" },
    { "name": "abrir POST /notes", "click": "#operations-default-create_note_notes_post .opblock-summary-control", "after": "document.querySelector('#operations-default-create_note_notes_post .try-out__btn')" },
    { "click": "#operations-default-create_note_notes_post .try-out__btn", "after": "document.querySelector('#operations-default-create_note_notes_post textarea.body-param__text')" },
    { "replace": ["#operations-default-create_note_notes_post textarea.body-param__text", "{\"title\": \"Nota de ensaio no navegador\"}"] },
    { "name": "Try it out: POST /notes", "click": "#operations-default-create_note_notes_post .execute",
      "after": "((document.querySelector('#operations-default-create_note_notes_post .live-responses-table tbody .response-col_status') || {}).textContent || '').trim().startsWith('201')", "settle": 800,
      "expect": { "server": true, "dbWrite": true, "functions": ["request validation (not observable)", "create_note", "clean_title", "record", "label"],
        "afterResponse": ["record", "label"], "effects": ["1 row added to notes", "1 row added to audit"] }, "snapshot": "criada" },
    { "name": "abrir GET /notes", "click": "#operations-default-list_notes_notes_get .opblock-summary-control", "after": "document.querySelector('#operations-default-list_notes_notes_get .try-out__btn')" },
    { "click": "#operations-default-list_notes_notes_get .try-out__btn", "after": "document.querySelector('#operations-default-list_notes_notes_get .execute')" },
    { "name": "Try it out: GET /notes", "click": "#operations-default-list_notes_notes_get .execute",
      "after": "((document.querySelector('#operations-default-list_notes_notes_get .live-responses-table tbody .response-col_status') || {}).textContent || '').trim().startsWith('200')", "settle": 800,
      "expect": { "server": true, "functions": ["list_notes", "summary"] } },
    { "name": "abrir PATCH /notes/{note_id}", "click": "#operations-default-rename_note_notes__note_id__patch .opblock-summary-control", "after": "document.querySelector('#operations-default-rename_note_notes__note_id__patch .try-out__btn')" },
    { "click": "#operations-default-rename_note_notes__note_id__patch .try-out__btn", "after": "document.querySelector('#operations-default-rename_note_notes__note_id__patch textarea.body-param__text')" },
    { "type": ["#operations-default-rename_note_notes__note_id__patch tr[data-param-name='note_id'] input", "1"] },
    { "replace": ["#operations-default-rename_note_notes__note_id__patch textarea.body-param__text", "{\"title\": \"Nota renomeada no navegador\"}"] },
    { "name": "Try it out: PATCH /notes/1", "click": "#operations-default-rename_note_notes__note_id__patch .execute",
      "after": "((document.querySelector('#operations-default-rename_note_notes__note_id__patch .live-responses-table tbody .response-col_status') || {}).textContent || '').trim().startsWith('200')", "settle": 800,
      "expect": { "server": true, "dbWrite": true, "functions": ["request validation (not observable)", "rename_note", "clean_title"], "effects": ["1 row changed in notes"] },
      "openBar": true }
  ]
}
