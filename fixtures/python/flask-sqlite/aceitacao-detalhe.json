{
  "name": "py-flask-detalhe",
  "root": "{codetac}/fixtures/python/flask-sqlite",
  "python": "{root}/.venv/bin/python",
  "args": ["-m", "flask", "--app", "app", "run", "--debug", "--port", "{port}"],
  "origin": "http://127.0.0.1:{port}",
  "readyPath": "/",
  "env": { "APP_DATABASE": "{out}/app.sqlite", "FLASK_SECRET_KEY": "chave-local-de-ensaio-detalhe" },
  "prepare": [["-e", "require('fs').rmSync(process.argv[1], { force: true })", "{out}/app.sqlite"]],
  "extraSecrets": ["chave-local-de-ensaio-detalhe", "palavra-passe-de-ensaio"],
  "steps": [
    { "name": "abrir", "goto": "/", "waitFor": "document.querySelector('form')", "snapshot": "login" },
    { "name": "pedir detalhe", "detail": { "functions": [
      { "file": "{root}/services/auth.py", "line": 10, "function": "authenticate" },
      { "file": "{root}/services/auth.py", "line": 6, "function": "hash_password" },
      { "file": "{root}/services/items.py", "line": 19, "function": "normalise" }], "files": [] } },
    { "type": ["input[name=username]", "ana"] },
    { "type": ["input[name=password]", "palavra-passe-de-ensaio"] },
    { "name": "Entrar, com detalhe", "click": "button[type=submit]", "after": "location.pathname === '/items'", "settle": 1000,
      "expect": { "server": true, "segments": 2, "detail": ["authenticate", "hash_password"] } },
    { "type": ["input[name=title]", "  Bolo   de laranja "] },
    { "name": "Acrescentar, com detalhe", "click": "form[action='/items'] button", "after": "document.querySelectorAll('li').length === 1", "settle": 1000,
      "expect": { "server": true, "dbWrite": true, "segments": 2, "detail": ["normalise"] }, "openBar": true }
  ]
}
