{
  "name": "mongo",
  "root": "fixtures/mongo",
  "readyPath": "/health",
  "args": ["server.cjs"],
  "env": { "MONGO_URL": "mongodb://127.0.0.1:27117/codetac" },
  "expect": ["dbWrite"],
  "extraSecrets": ["jorge.ataide@example.com", "segredo-da-nota-123"],
  "requests": [
    { "name": "nova-nota", "method": "POST", "path": "/api/notes", "json": { "text": "segredo-da-nota-123", "tag": "work" }, "accept": true },
    { "name": "listar", "path": "/api/notes?tag=work", "accept": true, "expect": ["dbRead"] },
    { "name": "mudar-etiqueta", "method": "PATCH", "path": "/api/notes/tag/work", "json": { "to": "done" }, "accept": true },
    { "name": "apagar", "method": "DELETE", "path": "/api/notes/tag/done", "accept": true },
    { "name": "registo-mongoose", "method": "POST", "path": "/api/users", "json": { "email": "jorge.ataide@example.com", "name": "Jorge" }, "accept": true },
    { "name": "upgrade-mongoose", "method": "POST", "path": "/api/users/upgrade", "json": { "email": "jorge.ataide@example.com" }, "accept": true }
  ]
}
