{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codetac.dev/schemas/structure-graph/1.json",
  "title": "StructureTAC graph",
  "description": "What a project is made of, as read by a language reader. Version 1. Every node and edge carries proof (file and line) and an origin. Secret values never appear: environment variables have names only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "reader",
    "nodes",
    "edges"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "types"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "types": {
          "description": "Detected project types, for example next-app-router, express, fastify, vite-react, workspace.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "languages": {
          "type": "array",
          "items": {
            "enum": [
              "node",
              "python"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "reader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "notes": {
      "description": "What the reader could not see or decide (honest failure), shown as is.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1
          },
          "proof": {
            "$ref": "#/$defs/proofList"
          },
          "path": {
            "description": "A folder of the project the note is about, ending in / ('' for the root). Phase 8: the folder a module chosen at run time is loaded from.",
            "type": "string"
          },
          "kind": {
            "description": "What kind of note, for the views that list them (phase 5: literal-key). Added in phase 5 without changing the version: optional, older graphs stay valid.",
            "type": "string",
            "pattern": "^[a-z][a-z-]*$"
          }
        }
      }
    }
  },
  "$defs": {
    "path": {
      "description": "Relative to the project root, with forward slashes; never absolute, never leaving the root.",
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*\\\\)(?!(.*/)?\\.\\.(/|$)).+$"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "line"
      ],
      "properties": {
        "file": {
          "$ref": "#/$defs/path"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "note": {
          "type": "string"
        }
      }
    },
    "proofList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/proof"
      }
    },
    "origin": {
      "enum": [
        "static",
        "observed",
        "ai"
      ]
    },
    "confidence": {
      "description": "certain by default; possible when the reader is not sure (principle 6).",
      "enum": [
        "certain",
        "possible"
      ]
    },
    "runsOn": {
      "enum": [
        "client",
        "server",
        "both",
        "unknown"
      ]
    },
    "layer": {
      "enum": [
        "interface",
        "routes",
        "logic",
        "data",
        "external",
        "config",
        "utilities",
        "tests",
        "unknown"
      ]
    },
    "common": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name",
        "proof",
        "origin"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "proof": {
          "$ref": "#/$defs/proofList"
        },
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "file",
            "symbol",
            "block",
            "service",
            "table",
            "env",
            "route"
          ]
        }
      },
      "oneOf": [
        {
          "$ref": "#/$defs/fileNode"
        },
        {
          "$ref": "#/$defs/symbolNode"
        },
        {
          "$ref": "#/$defs/blockNode"
        },
        {
          "$ref": "#/$defs/serviceNode"
        },
        {
          "$ref": "#/$defs/tableNode"
        },
        {
          "$ref": "#/$defs/envNode"
        },
        {
          "$ref": "#/$defs/routeNode"
        }
      ]
    },
    "fileNode": {
      "type": "object",
      "$ref": "#/$defs/common",
      "unevaluatedProperties": false,
      "required": [
        "path",
        "language",
        "size",
        "lines",
        "hash",
        "block",
        "rule"
      ],
      "properties": {
        "kind": {
          "const": "file"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "lines": {
          "type": "integer",
          "minimum": 0
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "block": {
          "$ref": "#/$defs/id"
        },
        "rule": {
          "description": "The rule that classified the file: config:<pattern> for a layer rule of codetac.structure.json, manual when the user reclassified the file.",
          "type": "string",
          "minLength": 1
        },
        "runsOn": {
          "$ref": "#/$defs/runsOn"
        }
      }
    },
    "symbolNode": {
      "type": "object",
      "$ref": "#/$defs/common",
      "unevaluatedProperties": false,
      "required": [
        "file",
        "symbolKind",
        "line",
        "key"
      ],
      "properties": {
        "kind": {
          "const": "symbol"
        },
        "file": {
          "$ref": "#/$defs/id"
        },
        "symbolKind": {
          "enum": [
            "function",
            "class",
            "method",
            "component",
            "variable"
          ]
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "exported": {
          "type": "boolean"
        },
        "exportedAs": {
          "description": "Other names the symbol is exported under (phase 8): default for export default, b for export { a as b }.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "key": {
          "description": "Stable key shared with the execution capture: path#name@line.",
          "type": "string",
          "pattern": "^[^#]+#.+@[1-9][0-9]*$"
        }
      }
    },
    "blockNode": {
      "type": "object",
      "$ref": "#/$defs/common",
      "unevaluatedProperties": false,
      "required": [
        "layer"
      ],
      "properties": {
        "kind": {
          "const": "block"
        },
        "layer": {
          "$ref": "#/$defs/layer"
        }
      }
    },
    "serviceNode": {
      "type": "object",
      "$ref": "#/$defs/common",
      "unevaluatedProperties": false,
      "required": [
        "category",
        "destination"
      ],
      "properties": {
        "kind": {
          "const": "service"
        },
        "category": {
          "enum": [
            "ai",
            "database",
            "payments",
            "analytics",
            "monitoring",
            "email",
            "messaging",
            "storage",
            "auth",
            "http"
          ]
        },
        "destination": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "host"
              ],
              "properties": {
                "type": {
                  "const": "literal"
                },
                "host": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "variable"
              ],
              "properties": {
                "type": {
                  "const": "env"
                },
                "variable": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "unknown"
                }
              }
            }
          ]
        }
      }
    },
    "tableNode": {
      "type": "object",
      "$ref": "#/$defs/common",
      "unevaluatedProperties": false,
      "properties": {
        "kind": {
          "const": "table"
        },
        "store": {
          "type": "string",
          "minLength": 1
        },
        "inferred": {
          "description": "Known only from use in the code, not from a schema.",
          "type": "boolean"
        },
        "source": {
          "description": "Where the table is defined (phase 6): prisma, drizzle, sql (migrations) or supabase-types. Absent when inferred.",
          "enum": [
            "prisma",
            "drizzle",
            "sql",
            "supabase-types"
          ]
        },
        "rls": {
          "description": "Row level security from the project's SQL files (phase 6): enabled or not, and how many policies. Absent when no SQL file mentions the table.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "policies",
            "proof"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "policies": {
              "type": "integer",
              "minimum": 0
            },
            "proof": {
              "$ref": "#/$defs/proofList"
            }
          }
        },
        "columns": {
          "description": "Columns from the schema source (phase 6), in definition order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/column"
          }
        }
      }
    },
    "envNode": {
      "type": "object",
      "$ref": "#/$defs/common",
      "description": "An environment variable, by name. There is no field for its value, on purpose.",
      "unevaluatedProperties": false,
      "properties": {
        "kind": {
          "const": "env"
        },
        "public": {
          "description": "Reaches the browser (NEXT_PUBLIC_, VITE_...).",
          "type": "boolean"
        },
        "secretLike": {
          "type": "boolean"
        }
      }
    },
    "routeNode": {
      "type": "object",
      "$ref": "#/$defs/common",
      "unevaluatedProperties": false,
      "required": [
        "method",
        "path"
      ],
      "properties": {
        "kind": {
          "const": "route"
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "HEAD",
            "OPTIONS",
            "ANY",
            "ACTION"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "from",
        "to",
        "proof",
        "origin"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "imports",
            "calls",
            "exposes",
            "reads",
            "writes",
            "sends-data-to",
            "uses-secret",
            "observed"
          ]
        },
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "proof": {
          "$ref": "#/$defs/proofList"
        },
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "count": {
          "description": "How many links an aggregated edge (between blocks) stands for.",
          "type": "integer",
          "minimum": 1
        },
        "runsOn": {
          "$ref": "#/$defs/runsOn"
        },
        "names": {
          "description": "For imports edges between files (phase 8): the names imported (default for the default export, * for all: a namespace, require() or import()).",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "operations": {
          "description": "For reads and writes edges (phase 6): the operations the code does on the table, in the SQL words.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "select",
              "insert",
              "update",
              "upsert",
              "delete"
            ]
          }
        }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "proof"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "primaryKey": {
          "type": "boolean"
        },
        "nullable": {
          "type": "boolean"
        },
        "unique": {
          "type": "boolean"
        },
        "references": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "table"
          ],
          "properties": {
            "table": {
              "description": "Table name (not id): it may be outside the project, such as auth.users.",
              "type": "string",
              "minLength": 1
            },
            "column": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "proof": {
          "$ref": "#/$defs/proofList"
        }
      }
    }
  }
}
